# Environment Variables Example
# Copy this file to .env and fill in your actual API keys
#
# Only the REQUIRED variables are needed for basic CLI usage.
# OPTIONAL variables are for example scripts and additional features.

# ==================== REQUIRED ====================
# ZhipuAI API (智谱AI) - Required for vision analysis
ZAI_API_KEY="your_zai_api_key_here"
ZAI_API_BASE="https://open.bigmodel.cn/api/paas/v4"
ZAI_API_CODING="https://open.bigmodel.cn/api/coding/paas/v4"

# ==================== OPTIONAL (Example Scripts) ====================
# Ark API (豆包/Doubao) - For example/doubao_with_bbox_demo.py
# ARK_API_KEY="your_ark_api_key_here"
# ARK_API_BASE="https://ark.cn-beijing.volces.com/api/v3"
# ARK_API_CODING="https://ark.cn-beijing.volces.com/api/coding/v3"

# ==================== OPTIONAL (Other APIs) ====================
# These keys are only referenced in .env but not actively used by CLI
# Uncomment if needed for your specific use case

# LITELLM_API_KEY="your_lite_llm_api_key_here"
# LITELLM_API_BASE="https://open.bigmodel.cn/api/paas/v4"
# LITELLM_MODEL="openai/GLM-4.5-Flash"

# DEEPSEEK_API_KEY="your_deepseek_api_key_here"
# DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# ALIBABA_CLOUD="your_alibaba_cloud_api_key_here"

# OPENAI_API_KEY="your_openai_api_key_here"
# OPENAI_API_BASE="https://api.openai.com/v1"

# DASHSCOPE_API_KEY="your_dashscope_api_key_here"
# DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# SILICONFLOW_API_KEY="your_siliconflow_api_key_here"
# SILICONFLOW_BASE_URL="https://api.siliconflow.cn/v1"

# GENSTUDIO_API_KEY="your_genstudio_api_key_here"
# GENSTUDIO_BASE_URL="https://cloud.infini-ai.com/maas/v1"

# LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY="your_langsmith_api_key_here"
# LANGSMITH_PROJECT="local-dev"
